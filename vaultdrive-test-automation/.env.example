# Copiar este archivo como .env y ajustar los valores locales.
# NUNCA subir el archivo .env al repositorio (está en .gitignore).

# URL del frontend React (Vite)
WEB_BASE_URL=http://localhost:5173

# URL base de la API ASP.NET Core (incluye /api)
API_BASE_URL=http://localhost:5213/api

# Contraseña usada para los usuarios de prueba que crea el framework.
# Valor de ejemplo: cada integrante define el suyo en su .env local.
TEST_USER_PASSWORD=<definir-en-env-local>

# Dominio reservado para correos de prueba (permite limpiar datos por patrón)
TEST_EMAIL_DOMAIN=vaultdrive.test

# Rendimiento (k6)
PERF_USER_COUNT=50
PERF_USER_PASSWORD=<definir-en-env-local>

# Ejecución
HEADLESS=true
CI=false
